# Copy this file to .env.local and fill in the values.
#
# ─── Pantry (state storage) ───────────────────────────────────────────────
# Create a free pantry at https://getpantry.cloud — you get a single UUID.
# That UUID is the only credential Pantry uses (no auth, no signup needed).
PANTRY_ID=00000000-0000-0000-0000-000000000000

# Required when using remote Pantry. Encrypts complete plans before upload.
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this server-only key backed up. Reuse it on every app instance.
# Changing or losing it makes existing encrypted plans unreadable.
PANTRY_ENCRYPTION_KEY=

# ─── Resend (email delivery) ──────────────────────────────────────────────
# https://resend.com — free tier. Create an API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The "From" address. To email arbitrary invitees you must verify a domain in
# Resend and use an address on it. Without a verified domain, Resend only
# delivers to the address that owns the account.
EMAIL_FROM=See Ya! <events@yourdomain.com>

# ─── App ──────────────────────────────────────────────────────────────────
# Public base URL used to build links inside emails. No trailing slash.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: set to "1" to log emails to the server console instead of sending
# (useful for local development without a Resend key).
EMAIL_DRY_RUN=0
